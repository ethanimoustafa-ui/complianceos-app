# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
.claude
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.playwright-mcp/
tests/e2e/_artifacts/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Random

*.txt
# Keep scope reference text (HANDOFF.md references it)
!scope/*.txt

# Sessions
/sessions

# MCP
/.playwright-mcp

# Playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache

# PDF fonts — exclude any stray TTFs/OTFs dropped at the top level of
# public/fonts/. The README.md there + the curated subdirectories
# (public/fonts/static-amiri/, public/fonts/static-inter/) are tracked.
# These globs are deliberately non-recursive so subdir TTFs ship with the repo.
public/fonts/*.ttf
public/fonts/*.otf

# Editor / OS
.idea
.vscode
Thumbs.db

# Logs
*.log
!npm-debug.log*
!yarn-debug.log*
!yarn-error.log*