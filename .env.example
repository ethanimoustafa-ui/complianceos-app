# ComplianceOS — environment template.
# Copy to `.env.local` and fill in. `.env.local` is git-ignored; never commit real values.

# ── Supabase (required) ─────────────────────────────────────────────────────
# Supabase Studio → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used by admin Route Handlers (src/lib/api/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cron (required for background jobs) ────────────────────────────────────
# Bearer secret that /api/cron/* checks. Vercel Cron sends it automatically when
# set as a project env var. Any long random string.
CRON_SECRET=

# ── LaTeX PDF renderer (optional — only the `engine: 'latex'` PDFs need it) ─
# Container lives in services/latex-renderer. LATEX_RENDER_SECRET must equal the
# container's RENDER_SECRET. Local Docker: http://localhost:8080 + 'dev-secret'.
LATEX_RENDER_URL=
LATEX_RENDER_SECRET=

# ── Email (optional — falls back to logging to the console) ─────────────────
# See src/lib/email/README.md for the full table.
RESEND_API_KEY=
# EMAIL_PROVIDER=log            # force 'resend' | 'log'
# EMAIL_FROM="ComplianceOS <alerts@yourdomain.sa>"
# EMAIL_REPLY_TO=
# EMAIL_APP_NAME=ComplianceOS
# EMAIL_APP_URL=
# Sandbox safety net: redirect EVERY email to this one address. Leave unset in production.
# EMAIL_OVERRIDE_TO=
